<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <PackageProjectUrl>https://github.com/anna-wro/FFXIV-Plugins</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Shortcut catalog, picker and icons, shared with Job Profiles. -->
  <ItemGroup>
    <Compile Include="../shared/Shortcuts/*.cs" LinkBase="shared/Shortcuts" />
  </ItemGroup>

  <!-- Choosing icons in the Icon Atlas plugin, shared with Retainer Cooldown. -->
  <ItemGroup>
    <Compile Include="../shared/IconAtlas/*.cs" LinkBase="shared/IconAtlas" />
  </ItemGroup>
</Project>
