<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Description>A tiny retainer venture cooldown HUD using only Dalamud and FFXIVClientStructs RetainerManager.</Description>
    <PackageProjectUrl>https://github.com/anna-wro/FFXIV-Plugins</PackageProjectUrl>
    <Authors>Kotanna</Authors>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Choosing icons in the Icon Atlas plugin, shared with Flick Wheel. -->
  <ItemGroup>
    <Compile Include="../shared/IconAtlas/*.cs" LinkBase="shared/IconAtlas" />
  </ItemGroup>

  <!-- Controller navigation in the windows, shared by most plugins. -->
  <ItemGroup>
    <Compile Include="../shared/Controller/*.cs" LinkBase="shared/Controller" />
  </ItemGroup>
</Project>
