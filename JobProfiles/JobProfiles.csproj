<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <PackageProjectUrl>https://github.com/ahsmutek/FFXIV-Plugins</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Shortcut catalog, picker and icons, shared with Flick Wheel. -->
  <ItemGroup>
    <Compile Include="../shared/Shortcuts/*.cs" LinkBase="shared/Shortcuts" />
  </ItemGroup>

  <!-- The shortcut picker takes an optional Icon Atlas picker; Job Profiles doesn't pass one. -->
  <ItemGroup>
    <Compile Include="../shared/IconAtlas/*.cs" LinkBase="shared/IconAtlas" />
  </ItemGroup>

  <!-- Tabler Icons and their MIT notice, shared with Keep in Mind. -->
  <ItemGroup>
    <Compile Include="../shared/Icons/*.cs" LinkBase="shared/Icons" />
    <EmbeddedResource Include="../shared/Icons/*.png" LogicalName="Icons.%(Filename)%(Extension)" />
    <None Include="../shared/Icons/LICENSE-tabler-icons.txt" Link="LICENSE-tabler-icons.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Controller navigation in the windows, shared by most plugins. -->
  <ItemGroup>
    <Compile Include="../shared/Controller/*.cs" LinkBase="shared/Controller" />
  </ItemGroup>
</Project>
