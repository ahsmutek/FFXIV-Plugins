<Project Sdk="Microsoft.NET.Sdk">
  <!-- Replays saved duties through the plugin's own interpreter, without the game. Not part of the plugin package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <DalamudLibPath>$(APPDATA)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Session.cs;../Observations.cs;../Registry.cs;../Interpreter.cs;../Raises.cs;../Partners.cs;../Lines.cs;../Journal.cs" LinkBase="Commendable" />
  </ItemGroup>

  <!-- For action, status, job and world names. -->
  <ItemGroup>
    <Reference Include="Lumina" HintPath="$(DalamudLibPath)Lumina.dll" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudLibPath)Lumina.Excel.dll" />
  </ItemGroup>
</Project>
