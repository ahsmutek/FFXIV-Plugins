<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <PackageProjectUrl>https://github.com/ahsmutek/FFXIV-Plugins</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The replay tool is its own console project that links the plugin's game-independent files. -->
  <ItemGroup>
    <Compile Remove="Replay/**" />
    <None Remove="Replay/**" />
  </ItemGroup>

  <!-- Tabler Icons and their MIT notice, shared with GlamKit, Keep in Mind and Job Profiles. -->
  <ItemGroup>
    <Compile Include="../shared/Icons/*.cs" LinkBase="shared/Icons" />
    <EmbeddedResource Include="../shared/Icons/*.png" LogicalName="Icons.%(Filename)%(Extension)" />
    <None Include="../shared/Icons/LICENSE-tabler-icons.txt" Link="LICENSE-tabler-icons.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Controller navigation in the windows, shared by most plugins. -->
  <ItemGroup>
    <Compile Include="../shared/Controller/*.cs" LinkBase="shared/Controller" />
  </ItemGroup>
</Project>
